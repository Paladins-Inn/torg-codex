{
  "request": {
    "method": "GET",
    "urlPath": "/api/vBeta/order_products",
    "headers": {
      "Authorization": {
        "equalTo": "wiremock-streaming-bearer-token"
      },
      "Accept": {
        "contains": "application/vnd.api+json"
      }
    },
    "queryParameters": {
      "page": {
        "equalTo": "1"
      },
      "archived": {
        "equalTo": "0"
      },
      "library": {
        "equalTo": "true"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/vnd.api+json"
    },
    "bodyFileName": "drivethru/owned-products-streaming-page1.json"
  }
}
