<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>de.paladins-inn.torg.codex</groupId>
    <artifactId>torg-codex-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>torg-codex-domain</artifactId>
  <name>torg-codex-domain</name>
  <description>torg-codex hexagonal domain module: framework-independent domain models, value objects, and domain events. MUST NOT depend on Spring, JPA/Jakarta Persistence, or Hibernate.</description>

  <properties>
    <java.version>25</java.version>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Import only for managed dependency *versions* (lombok, junit, assertj, jakarta.validation-api).
           No Spring/JPA/Hibernate artifact is ever declared below: this module must remain framework-free (FR-002). -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>4.0.6</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>jakarta.validation</groupId>
      <artifactId>jakarta.validation-api</artifactId>
    </dependency>

    <!-- Markup pipeline (relocated from torg-codex-data per ADR-017): the domain markup
         classes use commonmark for Markdown-to-HTML rendering. Production (compile) scope. -->
    <dependency>
      <groupId>org.commonmark</groupId>
      <artifactId>commonmark</artifactId>
      <version>0.24.0</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The domain artifact stays provider-free; its validation bootstrap tests need
         the provider explicitly on the test classpath. -->
    <dependency>
      <groupId>org.hibernate.validator</groupId>
      <artifactId>hibernate-validator</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.glassfish.expressly</groupId>
      <artifactId>expressly</artifactId>
      <version>6.0.0</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <release>${java.version}</release>
          <parameters>true</parameters>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>de.elnarion.maven</groupId>
        <artifactId>plantuml-generator-maven-plugin</artifactId>
        <version>3.0.1</version>

        <executions>
          <execution>
            <id>generate-class-diagram-markdown</id>
            <phase>process-classes</phase>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <outputDirectory>
                ${project.basedir}/../docs/modules/arc42/images/uml/classes
              </outputDirectory>
              <outputFilename>
                markdown-generator.puml
              </outputFilename>

              <scanPackages>
                <scanPackage>de.paladinsinn.torg.codex.domain.markup</scanPackage>
              </scanPackages>

              <hideMethods>true</hideMethods>
              <useShortClassNames>true</useShortClassNames>
            </configuration>
          </execution>
          <execution>
            <id>generate-class-diagram-domain</id>
            <phase>process-classes</phase>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <outputDirectory>
                ${project.basedir}/../docs/modules/arc42/images/uml/classes
              </outputDirectory>
              <outputFilename>
                torg-codex-domain.puml
              </outputFilename>

              <scanPackages>
                <scanPackage>de.paladinsinn.torg.codex.domain.event</scanPackage>
                <scanPackage>de.paladinsinn.torg.codex.domain.model</scanPackage>
                <scanPackage>de.paladinsinn.torg.codex.domain.validation</scanPackage>
              </scanPackages>

              <hideMethods>true</hideMethods>
              <useShortClassNames>true</useShortClassNames>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
