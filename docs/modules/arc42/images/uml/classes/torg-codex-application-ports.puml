Absent ..|>  CatalogDetailResult
CatalogBrowseResult "1" o-- "0..*"  FacetOption : availableCosms
CatalogBrowseResult "1" o-- "0..*"  ResolvedEntry : entries
CatalogBrowseResult *--  CatalogFilterCriteria : appliedCriteria
CatalogBrowseService "1" o-- "0..*"  AreaSource : sources
CatalogBrowseService *--  CatalogUsageObserver : usageObserver
CatalogBrowseService ..|>  CatalogBrowseQuery
CatalogFilterCriteria *--  SortDirection : direction
CatalogQueryService *--  CatalogPersistencePort : persistence
CatalogQueryService *--  CatalogUsageObserver : usageObserver
CatalogQueryService ..|>  CatalogQuery
CatalogReferenceQueryService *--  CatalogAccessObserver : observer
CatalogReferenceQueryService *--  CatalogReferencePersistencePort : persistence
CatalogReferenceQueryService ..|>  CatalogReferenceQuery
CatalogUsageObserver *--  CatalogUsageObserver : NO_OP
CodexHomeOverview "1" o-- "0..*"  CategorySummary : categories
CodexOverviewService "1" o-- "0..*"  AreaSource : sources
CodexOverviewService *--  CallerProductsPort : callerProducts
CodexOverviewService ..|>  CodexOverviewQuery
GrantedProduct ..|>  RawLookupResult
GrantedProductEntry ..|>  CatalogDetailResult
NotFound ..|>  RawLookupResult
PublicEntry ..|>  RawLookupResult
PublicReferenceEntry ..|>  CatalogDetailResult
ReferencedEntryResolver *--  CatalogAccessObserver : observer
ReferencedEntryResolver *--  CatalogPersistencePort : referenced
RestrictedCatalogQueryService *--  CallerProductsPort : callerProducts
RestrictedCatalogQueryService *--  CatalogAccessObserver : observer
RestrictedCatalogQueryService *--  CatalogPersistencePort : persistence
RestrictedCatalogQueryService *--  CatalogUsageObserver : usageObserver
RestrictedCatalogQueryService ..|>  RestrictedCatalogQuery
RestrictedTeaser "1" o-- "0..*"  RequiredProductRef : requiredProducts
RestrictedTeaser ..|>  CatalogDetailResult
Teaser ..|>  RawLookupResult

